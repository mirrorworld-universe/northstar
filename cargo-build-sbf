#!/usr/bin/env bash

set -euo pipefail

# Sonic: Cargo's colorized subcommand listing is not an executable-presence check.
if ! command -v cargo-build-sbf >/dev/null 2>&1; then
  cargo install cargo-build-sbf --version 4.5.0 --locked
fi
# Sonic: Keep Northstar's validated SBF ABI/compiler independent of CLI release defaults.
exec cargo build-sbf --arch v0 --tools-version v1.56 "$@"
