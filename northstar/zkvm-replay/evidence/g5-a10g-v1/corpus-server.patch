+pub(crate) struct TraceBufferGuard<F> {
+    buffer: Worker<PinnedBuffer<F>>,
+    release: bool,
+}
+
+impl<F> std::ops::Deref for TraceBufferGuard<F> {
+    type Target = Worker<PinnedBuffer<F>>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.buffer
+    }
+}
+
+impl<F> Drop for TraceBufferGuard<F> {
+    fn drop(&mut self) {
+        if self.release {
+            // Gnark needs these host pages after STARK proving; idle pinned pages cannot swap.
+            *self.buffer = PinnedBuffer::with_capacity(0);
+        }
+    }
+}
