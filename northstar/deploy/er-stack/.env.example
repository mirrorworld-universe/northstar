# Reference only. Set a new absolute directory on an isolated host.
NORTHSTAR_STACK_DIR=/srv/northstar-er-reference
NORTHSTAR_PORTAL_ID=REPLACE_WITH_REVIEWED_DEVNET_PORTAL

# Local build tags. For managed deployment, preload approved images by digest.
NORTHSTAR_VALIDATOR_IMAGE=northstar/er-validator:reference
NORTHSTAR_SIGNER_IMAGE=northstar/vrf-request-signer:reference
NORTHSTAR_PROVER_IMAGE=northstar/er-prover:reference
NORTHSTAR_GPU_DEVICE=0
