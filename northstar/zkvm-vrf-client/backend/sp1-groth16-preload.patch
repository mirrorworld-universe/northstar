+pub fn preload_groth16_bn254(data_dir: &str) -> Result<(), String> {
+    let data_dir = CString::new(data_dir).map_err(|error| error.to_string())?;
+    // The Go call borrows the directory for this call and returns an owned error string.
+    unsafe {
+        let error = bind::PreloadGroth16Bn254(data_dir.as_ptr() as *mut c_char);
+        if error.is_null() {
+            Ok(())
+        } else {
+            Err(ptr_to_string_freed(error))
+        }
+    }
+}
+
 pub fn build_groth16_bn254(data_dir: &str) {
     build(ProofSystem::Groth16, data_dir)
 }
