new file mode 100644
index 0000000..3ddec91
--- /dev/null
+++ b/crates/recursion/gnark-ffi/go/sp1/groth16_diagnostics.go
@@ -0,0 +1,23 @@
+//go:build icicle
+
+package sp1
+
+import (
+	"fmt"
+
+	"github.com/consensys/gnark/constraint"
+	constraint_bn254 "github.com/consensys/gnark/constraint/bn254"
+)
+
+func trimGroth16Diagnostics(system constraint.ConstraintSystem) (int, int, error) {
+	circuit, ok := system.(*constraint_bn254.R1CS)
+	if !ok || circuit == nil {
+		return 0, 0, fmt.Errorf("unexpected Groth16 constraint-system type %T", system)
+	}
+	entries, indices := len(circuit.DebugInfo), len(circuit.MDebug)
+	// These source annotations format solver errors; they are not constraints or solver inputs.
+	circuit.DebugInfo = nil
+	circuit.MDebug = nil
+	circuit.SymbolTable = (constraint_bn254.R1CS{}).SymbolTable
+	return entries, indices, nil
+}
