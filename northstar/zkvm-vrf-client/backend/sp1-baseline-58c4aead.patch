@@ -0,0 +1,70 @@
+//go:build icicle
+
+package sp1
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/constraint"
+	constraint_bn254 "github.com/consensys/gnark/constraint/bn254"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/frontend/cs/r1cs"
+)
+
+type diagnosticsCircuit struct {
+	X        frontend.Variable
+	Expected frontend.Variable `gnark:",public"`
+}
+
+func (c *diagnosticsCircuit) Define(api frontend.API) error {
+	api.AssertIsEqual(api.Mul(c.X, c.X), c.Expected)
+	return nil
+}
+
+func TestTrimGroth16DiagnosticsPreservesConstraintChecks(t *testing.T) {
+	compiled, err := frontend.Compile(ecc.BN254.ScalarField(), r1cs.NewBuilder, &diagnosticsCircuit{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	circuit := compiled.(*constraint_bn254.R1CS)
+	instructions := append([]constraint.PackedInstruction(nil), circuit.Instructions...)
+	calldata := append([]uint32(nil), circuit.CallData...)
+	constraints := circuit.GetNbConstraints()
+	entries, indices := len(circuit.DebugInfo), len(circuit.MDebug)
+	if entries == 0 || indices == 0 {
+		t.Fatal("test circuit must contain diagnostic metadata")
+	}
+	check := func(expected int, wantError bool) {
+		t.Helper()
+		witness, err := frontend.NewWitness(&diagnosticsCircuit{X: 3, Expected: expected}, ecc.BN254.ScalarField())
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, err = circuit.Solve(witness)
+		if (err != nil) != wantError {
+			t.Fatalf("expected=%d wantError=%v got=%v", expected, wantError, err)
+		}
+	}
+	check(9, false)
+	check(10, true)
+	removedEntries, removedIndices, err := trimGroth16Diagnostics(circuit)
+	if err != nil || removedEntries != entries || removedIndices != indices {
+		t.Fatalf("trim result: entries=%d indices=%d error=%v", removedEntries, removedIndices, err)
+	}
+	if circuit.DebugInfo != nil || circuit.MDebug != nil || !reflect.DeepEqual(circuit.SymbolTable, (constraint_bn254.R1CS{}).SymbolTable) {
+		t.Fatal("diagnostic metadata was retained")
+	}
+	if constraints != circuit.GetNbConstraints() || !reflect.DeepEqual(instructions, circuit.Instructions) || !reflect.DeepEqual(calldata, circuit.CallData) {
+		t.Fatal("constraint data changed")
+	}
+	check(9, false)
+	check(10, true)
+}
+
+func TestTrimGroth16DiagnosticsRejectsNil(t *testing.T) {
+	if _, _, err := trimGroth16Diagnostics(nil); err == nil {
+		t.Fatal("nil constraint system accepted")
+	}
+}
diff --git a/crates/recursion/gnark-ffi/go/sp1/groth16_domain_cache.go b/crates/recursion/gnark-ffi/go/sp1/groth16_domain_cache.go
new file mode 100644
index 0000000..06599ce
--- /dev/null
+++ b/crates/recursion/gnark-ffi/go/sp1/groth16_domain_cache.go
@@ -0,0 +1,35 @@
+//go:build icicle
+
+package sp1
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr/fft"
+	dump "github.com/consensys/gnark-crypto/utils/unsafe"
+)
+
+func withoutCPUFFTCache(reader io.Reader) (io.Reader, error) {
+	var layout bytes.Buffer
+	if err := dump.WriteMarker(&layout); err != nil {
+		return nil, err
+	}
+	var domain fft.Domain
+	if _, err := domain.WriteTo(&layout); err != nil {
+		return nil, err
+	}
+
+	header := layout.Bytes()
+	if _, err := io.ReadFull(reader, header); err != nil {
+		return nil, fmt.Errorf("read proving-key domain: %w", err)
+	}
+	if header[len(header)-1] > 1 {
+		return nil, fmt.Errorf("invalid FFT precomputation flag")
+	}
+	// This final domain byte enables CPU-only FFT tables. Icicle uses GPU FFTs;
+	// preserve every field element, key point, and the architecture marker.
+	header[len(header)-1] = 0
+	return io.MultiReader(bytes.NewReader(header), reader), nil
+}
diff --git a/crates/recursion/gnark-ffi/go/sp1/groth16_domain_cache_test.go b/crates/recursion/gnark-ffi/go/sp1/groth16_domain_cache_test.go
new file mode 100644
index 0000000..4503b3d
--- /dev/null
+++ b/crates/recursion/gnark-ffi/go/sp1/groth16_domain_cache_test.go
@@ -0,0 +1,104 @@
+//go:build icicle
+
+package sp1
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr/fft"
+	dump "github.com/consensys/gnark-crypto/utils/unsafe"
+)
+
+func TestWithoutCPUFFTCachePreservesDomainAndPayload(t *testing.T) {
+	for _, size := range []uint64{32, 256} {
+		for _, shiftValue := range []uint64{5, 7} {
+			var shift fr.Element
+			shift.SetUint64(shiftValue)
+			domain := fft.NewDomain(size, fft.WithShift(shift))
+			var input bytes.Buffer
+			if err := dump.WriteMarker(&input); err != nil {
+				t.Fatal(err)
+			}
+			markerSize := input.Len()
+			if _, err := domain.WriteTo(&input); err != nil {
+				t.Fatal(err)
+			}
+			flagOffset := input.Len() - 1
+			input.WriteString("unchanged proving-key payload")
+			original := bytes.Clone(input.Bytes())
+			reader, err := withoutCPUFFTCache(bytes.NewReader(original))
+			if err != nil {
+				t.Fatal(err)
+			}
+			encoded, err := io.ReadAll(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if encoded[flagOffset] != 0 || original[flagOffset] != 1 {
+				t.Fatal("cache flag was not disabled or source bytes were mutated")
+			}
+			expected := bytes.Clone(original)
+			expected[flagOffset] = 0
+			if !bytes.Equal(encoded, expected) {
+				t.Fatal("domain fields, marker, or key payload changed")
+			}
+			var decoded fft.Domain
+			if _, err := decoded.ReadFrom(bytes.NewReader(encoded[markerSize:])); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := decoded.Twiddles(); err == nil {
+				t.Fatal("CPU FFT cache was allocated")
+			}
+			if _, err := decoded.CosetTable(); err == nil {
+				t.Fatal("CPU coset cache was allocated")
+			}
+			cached, uncached := make([]fr.Element, size), make([]fr.Element, size)
+			for i := range cached {
+				cached[i].SetUint64(uint64(i*i + 1))
+			}
+			copy(uncached, cached)
+			domain.FFT(cached, fft.DIF, fft.OnCoset())
+			decoded.FFT(uncached, fft.DIF, fft.OnCoset())
+			for i := range cached {
+				if !cached[i].Equal(&uncached[i]) {
+					t.Fatalf("FFT mismatch at %d", i)
+				}
+			}
+			domain.FFTInverse(cached, fft.DIT, fft.OnCoset())
+			decoded.FFTInverse(uncached, fft.DIT, fft.OnCoset())
+			for i := range cached {
+				var expected fr.Element
+				expected.SetUint64(uint64(i*i + 1))
+				if !cached[i].Equal(&expected) || !uncached[i].Equal(&expected) {
+					t.Fatalf("inverse FFT mismatch at %d", i)
+				}
+			}
+		}
+	}
+}
+
+func TestWithoutCPUFFTCacheRejectsTruncatedDomain(t *testing.T) {
+	if _, err := withoutCPUFFTCache(bytes.NewReader([]byte{1})); !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("expected truncated-domain error, got %v", err)
+	}
+}
+
+func TestWithoutCPUFFTCacheRejectsInvalidFlag(t *testing.T) {
+	var input bytes.Buffer
+	if err := dump.WriteMarker(&input); err != nil {
+		t.Fatal(err)
+	}
+	var domain fft.Domain
+	if _, err := domain.WriteTo(&input); err != nil {
+		t.Fatal(err)
+	}
+	header := input.Bytes()
+	header[len(header)-1] = 2
+	if _, err := withoutCPUFFTCache(bytes.NewReader(header)); err == nil {
+		t.Fatal("expected invalid-flag error")
+	}
+}
