@@ -0,0 +1,60 @@
+//go:build icicle
+
+package sp1
+
+import (
+	"fmt"
+	"os"
+	"runtime"
+	"runtime/pprof"
+
+	constraint_bn254 "github.com/consensys/gnark/constraint/bn254"
+)
+
+func startGroth16Profile() func() {
+	dir := os.Getenv("SP1_GROTH16_PROFILE_DIR")
+	if dir == "" {
+		return func() {}
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		panic(err)
+	}
+	file, err := os.CreateTemp(dir, "groth16-*.cpu.pprof")
+	if err != nil {
+		panic(err)
+	}
+	if err := pprof.StartCPUProfile(file); err != nil {
+		file.Close()
+		panic(err)
+	}
+	memory := func(stage string) {
+		var stats runtime.MemStats
+		runtime.ReadMemStats(&stats)
+		fmt.Printf("GNARK_MEMORY stage=%s heap_alloc_bytes=%d heap_inuse_bytes=%d heap_sys_bytes=%d num_gc=%d gc_cpu_fraction=%f\n",
+			stage, stats.HeapAlloc, stats.HeapInuse, stats.HeapSys, stats.NumGC, stats.GCCPUFraction)
+	}
+	if circuit, ok := globalR1cs.(*constraint_bn254.R1CS); ok {
+		fmt.Printf("GNARK_LAYOUT instructions=%d calldata_words=%d levels=%d debug_entries=%d debug_index_entries=%d logs=%d internal_variables=%d\n",
+			len(circuit.Instructions), len(circuit.CallData), len(circuit.Levels), len(circuit.DebugInfo), len(circuit.MDebug), len(circuit.Logs), circuit.NbInternalVariables)
+	}
+	memory("before_prove")
+	return func() {
+		pprof.StopCPUProfile()
+		if err := file.Close(); err != nil {
+			panic(err)
+		}
+		memory("after_prove")
+		heap, err := os.Create(file.Name() + ".heap")
+		if err != nil {
+			panic(err)
+		}
+		if err := pprof.WriteHeapProfile(heap); err != nil {
+			heap.Close()
+			panic(err)
+		}
+		if err := heap.Close(); err != nil {
+			panic(err)
+		}
+		fmt.Printf("GNARK_PROFILE cpu=%s heap=%s\n", file.Name(), heap.Name())
+	}
+}
